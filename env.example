# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Local Postgres (matches docker-compose.yml defaults - change if you're pointing at
# your own local/existing Postgres instead)
DATABASE_URL=postgresql://testtag:testtag@localhost:5432/testtag

# Same Anthropic API key used by TouchTrace
ANTHROPIC_API_KEY=

# Shared team access token - pick anything, just has to match what you type into the app
APP_ACCESS_TOKEN=

PORT=3000
